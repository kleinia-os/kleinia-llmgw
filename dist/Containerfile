# OCI packaging for kleinia-llmgw: multi-stage build embedding the nfpm-built
# RPM into a Fedora 44 runtime image.
#   runtime (default)  fedora:44 + the RPM — runnable gateway image
#   artifacts          FROM scratch carrying /rpms/*.rpm — the artifact
#                      consumed by the kleinia assembly repo (artifacts.yml)
#   just image     ->  localhost/kleinia/kleinia-llmgw:<version> (local store)
#   just artifact  ->  localhost/kleinia/kleinia-llmgw:rpm (RPM carrier)

ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS builder
RUN dnf -y install curl tar git && dnf clean all
# Fedora's packaged golang is older than the go 1.27 toolchain go.mod requires;
# use the official upstream tarball instead.
ARG GO_VERSION=1.27.4
RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -xz -C /usr/local \
 && ln -s /usr/local/go/bin/go /usr/local/bin/go && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt
ARG JUST_VERSION=1.59.0
ARG NFPM_VERSION=2.49.0
RUN curl -fsSL -o /tmp/just.tgz \
      https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz \
 && tar -xzf /tmp/just.tgz -C /usr/local/bin just \
 && curl -fsSL -o /tmp/nfpm.tgz \
      https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}/nfpm_${NFPM_VERSION}_Linux_x86_64.tar.gz \
 && tar -xzf /tmp/nfpm.tgz -C /usr/local/bin nfpm
WORKDIR /src
COPY . .
RUN just package

FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}
# no extra runtime deps: the Go binaries link only glibc, present in the base image
COPY --from=builder /src/build-out/*.rpm /tmp/
RUN rpm -Uvh /tmp/*.rpm && rm -f /tmp/*.rpm
ENTRYPOINT ["/usr/bin/llmgwctl"]

# RPM-carrier stage for the kleinia assembly repo (same contract as
# kleinia-installer): a scratch image whose /rpms/ holds the built packages.
FROM scratch AS artifacts
COPY --from=builder /src/build-out/*.rpm /rpms/
